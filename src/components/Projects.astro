---
import { featuredWorks, works } from "../data/works";
---

<section id="projects" class="px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <div class="mb-12 flex items-end justify-between gap-4">
      <div>
        <h2 class="mb-2 font-mono text-sm text-accent">Projects</h2>
        <h3 class="text-2xl font-bold text-white sm:text-3xl">Selected work</h3>
      </div>
      <a
        href="/works"
        class="group hidden shrink-0 items-center gap-1.5 text-sm text-zinc-400 transition hover:text-white sm:inline-flex"
      >
        All {works.length} works
        <span class="transition group-hover:translate-x-0.5">&rarr;</span>
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        featuredWorks.map((project) => (
          <a
            href={`/works/${project.slug}`}
            class="group flex flex-col rounded-xl border border-zinc-800 bg-zinc-900/30 p-6 transition hover:border-zinc-700 hover:bg-zinc-900/50"
          >
            <div class="mb-3 flex items-start justify-between gap-3">
              <h4 class="text-lg font-semibold text-white transition group-hover:text-accent">
                {project.name}
              </h4>
              <span class="shrink-0 rounded-full border border-zinc-700 bg-zinc-800/50 px-2.5 py-0.5 text-[10px] font-medium text-zinc-400">
                {project.metric}
              </span>
            </div>

            <p class="mb-4 flex-1 text-sm leading-relaxed text-zinc-300">
              {project.summary}
            </p>

            <div class="flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span class="rounded border border-zinc-800 bg-zinc-950/50 px-2 py-0.5 text-[10px] text-zinc-500">
                  {tag}
                </span>
              ))}
            </div>

            <div class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium text-zinc-500 transition group-hover:text-accent">
              View details
              <span class="transition group-hover:translate-x-0.5">&rarr;</span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-8 sm:hidden">
      <a
        href="/works"
        class="group inline-flex items-center gap-1.5 text-sm text-zinc-400 transition hover:text-white"
      >
        All {works.length} works
        <span class="transition group-hover:translate-x-0.5">&rarr;</span>
      </a>
    </div>
  </div>
</section>
