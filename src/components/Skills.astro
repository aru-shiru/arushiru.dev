---
const categories = [
  {
    title: "Mobile",
    skills: ["Flutter", "React Native", "Expo", "Swift", "Kotlin"],
  },
  {
    title: "Frontend",
    skills: ["React", "Next.js", "Vue", "Nuxt", "TypeScript", "TanStack Query", "Tailwind CSS"],
  },
  {
    title: "Backend",
    skills: ["NestJS", "Laravel", "Node.js", "PHP"],
  },
  {
    title: "Data & Infrastructure",
    skills: ["PostgreSQL", "Firebase", "Supabase", "Docker", "SQLite", "Valkey"],
  },
];
---

<section id="skills" class="px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <h2 class="mb-2 font-mono text-sm text-accent">Skills</h2>
    <h3 class="mb-12 text-2xl font-bold text-white sm:text-3xl">Technical expertise</h3>

    <div class="grid gap-6 sm:grid-cols-2">
      {
        categories.map((cat) => (
          <div class="rounded-xl border border-zinc-800 bg-zinc-900/30 p-6">
            <h4 class="mb-4 font-mono text-xs uppercase tracking-wider text-zinc-500">
              {cat.title}
            </h4>
            <div class="flex flex-wrap gap-2">
              {cat.skills.map((skill) => (
                <span class="rounded-md border border-zinc-800 bg-zinc-900/50 px-3 py-1.5 text-xs font-medium text-zinc-300">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
