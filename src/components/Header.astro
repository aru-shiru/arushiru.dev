---
const links = [
  { href: "/#about", label: "About" },
  { href: "/#skills", label: "Skills" },
  { href: "/#experience", label: "Experience" },
  { href: "/works", label: "Works" },
  { href: "/#contact", label: "Contact" },
];
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 border-b border-zinc-800/50 bg-zinc-950/80 backdrop-blur-lg"
>
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="font-mono text-sm font-medium text-white transition hover:text-accent">
      aru-shiru<span class="text-accent">.</span>dev
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-zinc-400 transition hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="menu-toggle"
      class="flex items-center justify-center md:hidden text-zinc-400 hover:text-white transition"
      aria-label="Toggle menu"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-zinc-800/50 md:hidden">
    <ul class="flex flex-col gap-1 px-6 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-link block rounded-lg px-3 py-2 text-sm text-zinc-400 transition hover:bg-zinc-800/50 hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const mobileLinks = menu?.querySelectorAll(".mobile-link");

  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });

  mobileLinks?.forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
    });
  });
</script>
