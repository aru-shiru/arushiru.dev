---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { works } from "../data/works";
---

<Layout
  title="Works — Muhammad Dzul Arsyil"
  description="A collection of production software projects across mobile, web, backend, and infrastructure — built and shipped at scale."
>
  <Header />
  <main class="px-6 pt-32 pb-24">
    <div class="mx-auto max-w-5xl">
      <a
        href="/"
        class="group mb-8 inline-flex items-center gap-1.5 text-sm text-zinc-500 transition hover:text-white"
      >
        <span class="transition group-hover:-translate-x-0.5">&larr;</span>
        Back home
      </a>

      <h1 class="mb-2 font-mono text-sm text-accent">Works</h1>
      <h2 class="mb-4 text-3xl font-bold text-white sm:text-4xl">
        Things I've built
      </h2>
      <p class="mb-14 max-w-2xl text-base leading-relaxed text-zinc-400">
        A selection of production systems I've designed, built, and led across
        mobile, web, backend, and infrastructure &mdash; shipping to millions of
        users. Select any project for a closer look.
      </p>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          works.map((work) => (
            <a
              href={`/works/${work.slug}`}
              class="group flex flex-col rounded-xl border border-zinc-800 bg-zinc-900/30 p-6 transition hover:border-zinc-700 hover:bg-zinc-900/50"
            >
              <div class="mb-3 flex items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-semibold text-white transition group-hover:text-accent">
                    {work.name}
                  </h3>
                  <span class="font-mono text-xs text-zinc-500">
                    {work.category}
                  </span>
                </div>
                <span class="shrink-0 rounded-full border border-zinc-700 bg-zinc-800/50 px-2.5 py-0.5 text-[10px] font-medium text-zinc-400">
                  {work.metric}
                </span>
              </div>

              <p class="mb-4 flex-1 text-sm leading-relaxed text-zinc-300">
                {work.description}
              </p>

              <div class="flex flex-wrap gap-1.5">
                {work.tags.map((tag) => (
                  <span class="rounded border border-zinc-800 bg-zinc-950/50 px-2 py-0.5 text-[10px] text-zinc-500">
                    {tag}
                  </span>
                ))}
              </div>

              <div class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium text-zinc-500 transition group-hover:text-accent">
                View details
                <span class="transition group-hover:translate-x-0.5">&rarr;</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>
