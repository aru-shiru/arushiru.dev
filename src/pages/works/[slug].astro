---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { works } from "../../data/works";

export function getStaticPaths() {
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
---

<Layout
  title={`${work.name} — Muhammad Dzul Arsyil`}
  description={work.summary}
>
  <Header />
  <main class="px-6 pt-32 pb-24">
    <div class="mx-auto max-w-3xl">
      <a
        href="/works"
        class="group mb-8 inline-flex items-center gap-1.5 text-sm text-zinc-500 transition hover:text-white"
      >
        <span class="transition group-hover:-translate-x-0.5">&larr;</span>
        All works
      </a>

      <div class="mb-4 flex flex-wrap items-center gap-3">
        <span class="font-mono text-xs text-accent">{work.category}</span>
        <span class="h-1 w-1 rounded-full bg-zinc-700"></span>
        <span
          class="rounded-full border border-zinc-700 bg-zinc-800/50 px-2.5 py-0.5 text-[10px] font-medium text-zinc-400"
        >
          {work.metric}
        </span>
      </div>

      <h1 class="mb-4 text-3xl font-bold text-white sm:text-4xl">
        {work.name}
      </h1>
      <p class="mb-12 text-lg leading-relaxed text-zinc-400">
        {work.summary}
      </p>

      <section class="mb-12">
        <h2 class="mb-4 font-mono text-sm text-accent">Overview</h2>
        <div class="space-y-4 text-base leading-relaxed text-zinc-300">
          {work.overview.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="mb-12">
        <h2 class="mb-4 font-mono text-sm text-accent">Highlights</h2>
        <ul class="space-y-2">
          {
            work.highlights.map((highlight) => (
              <li class="flex items-start gap-3 text-base text-zinc-300">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                {highlight}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mb-16">
        <h2 class="mb-4 font-mono text-sm text-accent">Tech stack</h2>
        <div class="flex flex-wrap gap-2">
          {
            work.stack.map((tech) => (
              <span class="rounded-lg border border-zinc-800 bg-zinc-900/50 px-3 py-1 text-sm text-zinc-300">
                {tech}
              </span>
            ))
          }
        </div>
      </section>

      <div class="border-t border-zinc-800/50 pt-8">
        <a
          href="/works"
          class="group inline-flex items-center gap-1.5 text-sm text-zinc-400 transition hover:text-white"
        >
          <span class="transition group-hover:-translate-x-0.5">&larr;</span>
          Back to all works
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
